{
    "coding_flow": {
        "name": "Coding Flow",
        "description": "Open VS Code, a terminal and GitHub.",
        "actions": [
            {
                "type": "launch",
                "target": "code",
                "label": "VS Code"
            },
            {
                "type": "launch",
                "target": "terminal",
                "label": "Terminal"
            },
            {
                "type": "website",
                "url": "https://github.com",
                "label": "GitHub"
            }
        ]
    },
    "presentation_start": {
        "name": "Start Presentation",
        "actions": [
            {
                "type": "powerpoint",
                "command": "start_presentation"
            }
        ]
    },
    "presentation_end": {
        "name": "End Presentation",
        "actions": [
            {
                "type": "powerpoint",
                "command": "end_presentation"
            }
        ]
    },
    "presentation_next": {
        "name": "Next Slide",
        "actions": [
            {
                "type": "powerpoint",
                "command": "next_slide"
            }
        ]
    },
    "presentation_previous": {
        "name": "Previous Slide",
        "actions": [
            {
                "type": "powerpoint",
                "command": "previous_slide"
            }
        ]
    }
}